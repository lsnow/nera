fn main() -> u64 {
    let mut values = [19, 22];
    let item = &mut values[0];
    *item = *item + 1;
    // Last-use analysis ends the local mutable borrow before the shared view.
    let view = identity(&values[..]);
    return view[0] + view[1];
}

// The returned borrow is tied to its input without named lifetime parameters.
fn identity(value: &[u64]) -> &[u64] {
    return value;
}

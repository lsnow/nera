// The 8.1–8.3 backing/left/middle/remaining example behind a sealed owner API.
opaque struct Arena { cursor:usize, slots:[u64;6], }
predicate Ready(p:ptr<Arena>) {
    exists used:usize = p.cursor;
    owns(p);
    initialized(p.slots,0usize..6usize);
    used<=6usize;
}
fn main()->u64 {
    let arena=make();
    let total=client(&mut *arena,1usize,3usize);
    reset(&mut *arena);
    destroy(arena);
    return total;
}
fn make()->Own<Arena>
ensures Ready(result);
ensures result.cursor==0usize;
{
    let p=alloc<Arena>(1);
    p.cursor=0usize;
    p.slots=[0,0,0,0,0,0];
    fold Ready(p);
    return p;
}
fn client(arena:&mut Arena,first:usize,second:usize)->u64
requires Ready(arena);
ensures Ready(arena);
{
    let parent=reserve(&mut *arena,6usize);
    if first>0usize {
        if first<second {
            if second<len(parent) {
                let left=&mut parent[..first];
                let middle=&mut parent[first..second];
                let remaining=&mut parent[second..];
                remaining[0]=7;
                left[0]=12;
                middle[0]=30;
                let sum=left[0]+middle[0];
                let sentinel=remaining[0];
                parent[0]=sum;
                return parent[0]+sentinel;
            }
        }
    }
    return 0;
}
fn reserve(p:&mut Arena,count:usize)->&mut [u64]
requires Ready(p);
requires count<=6usize;
ensures Ready(p);
ensures p.cursor==old(p.cursor)+len(result);
ensures len(result)<=count;
{
    unfold Ready(p);
    let start=p.cursor;
    let end=start+count;
    if end<=6usize {
        p.cursor=end;
        let view=&mut p.slots[start..end];
        fold Ready(p);
        return view;
    }
    let empty=&mut p.slots[0usize..0usize];
    fold Ready(p);
    return empty;
}
fn reset(p:&mut Arena)
requires Ready(p);
ensures Ready(p);
ensures p.cursor==0usize;
{
    unfold Ready(p);
    p.cursor=0usize;
    fold Ready(p);
    return;
}
fn destroy(p:Own<Arena>)
requires Ready(p);
{
    unfold Ready(p);
    free(p);
    finish Ready(p);
    return;
}

// Distinct concrete witnesses can be hidden at a closed-package join.
struct Cell { value:u64, }
predicate Ready(p:ptr<Cell>) {
    exists used:usize = 0usize;
    owns(p);
    initialized(p.value,0..1);
    p.value<=42;
    used<=7usize;
}
fn main()->u64 {
    let p=alloc<Cell>(1);
    p.value=42;
    fold Ready(p);
    let q=choose(p,true);
    unfold Ready(q);
    let outcome=q.value;
    free(q);
    finish Ready(q);
    return outcome;
}
fn choose(p:Own<Cell>,which:bool)->Own<Cell>
requires Ready(p);
ensures Ready(result);
{
    unfold Ready(p);
    if which {
        fold Ready(p) with (used=1usize);
    } else {
        fold Ready(p) with (used=2usize);
    }
    unfold Ready(p) as (saved);
    fold Ready(p) with (used=saved);
    return p;
}

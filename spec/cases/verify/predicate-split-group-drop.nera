// Two storage objects retain one cleanup group until both resources die.
struct Storage { item:Own<u64>, }
predicate Pair(a:ptr<u64>,b:ptr<u64>) {
    owns(a);
    owns(b);
    initialized(a,0usize..1usize);
}
fn main()->u64 {
    let a=alloc<u64>(1);
    let b=alloc<u64>(1);
    *a=42;
    let total=*a;
    fold Pair(a,b);
    let left=Storage { item:a };
    let right=Storage { item:b };
    return total;
}

// Opened witnesses stay ghost values across an inductive loop. The callee
// knows only the existential package and its bounds, not the caller's choice. The limit remains symbolic inside consume.
struct Cell { value:u64, }
predicate Ready(p:ptr<Cell>,limit:usize) {
    exists used:usize = 0usize;
    exists enabled:bool = true;
    owns(p);
    initialized(p.value,0..1);
    used<=limit;
    enabled;
}
fn main()->u64 {
    let limit=7usize;
    let p=alloc<Cell>(1);
    p.value=42;
    fold Ready(p,limit) with (used=6usize);
    return consume(p,limit);
}
fn consume(p:Own<Cell>,limit:usize)->u64
requires Ready(p,limit);
{
    unfold Ready(p,limit) as (saved,on);
    let mut i=0usize;
    while i<limit {
        invariant i<=limit;
        invariant saved<=limit;
        invariant on;
        i=i+1usize;
    }
    let outcome=p.value;
    free(p);
    finish Ready(p,limit);
    return outcome;
}

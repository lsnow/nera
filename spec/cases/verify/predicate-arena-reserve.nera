// Bounded reserve protocol: success, capacity exhaustion, view release and reset.
opaque struct Arena { cursor:usize, slots:[u64;6], }
predicate Ready(p:ptr<Arena>) {
    exists used:usize = p.cursor;
    owns(p);
    initialized(p.slots,0usize..6usize);
    used<=6usize;
}
fn main()->u64 {
    let arena=make();
    let full=reserve(&mut *arena,6usize);
    let filled=len(full)==6usize;
    let failed=reserve(&mut *arena,1usize);
    let empty=len(failed)==0usize;
    reset(&mut *arena);
    destroy(arena);
    if filled { if empty { return 42; } }
    return 0;
}
fn make()->Own<Arena>
ensures Ready(result);
ensures result.cursor==0usize;
{
    let p=alloc<Arena>(1);
    p.cursor=0usize;
    p.slots=[0,0,0,0,0,0];
    fold Ready(p);
    return p;
}
fn reserve(p:&mut Arena,count:usize)->&mut [u64]
requires Ready(p);
requires count<=6usize;
ensures Ready(p);
ensures p.cursor==old(p.cursor)+len(result);
ensures len(result)<=count;
{
    unfold Ready(p);
    let start=p.cursor;
    let end=start+count;
    if end<=6usize {
        p.cursor=end;
        let view=&mut p.slots[start..end];
        fold Ready(p);
        return view;
    }
    let empty=&mut p.slots[0usize..0usize];
    fold Ready(p);
    return empty;
}
fn reset(p:&mut Arena)
requires Ready(p);
ensures Ready(p);
ensures p.cursor==0usize;
{
    unfold Ready(p);
    p.cursor=0usize;
    fold Ready(p);
    return;
}
fn destroy(p:Own<Arena>)
requires Ready(p);
{
    unfold Ready(p);
    free(p);
    finish Ready(p);
    return;
}

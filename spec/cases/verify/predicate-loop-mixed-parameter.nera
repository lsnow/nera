// base keeps its entry capture; count is rebound at the arbitrary loop head.
// The separate base parameter shares the fixed leaf of the mixed expression.
struct Cell { value:u64, }
predicate Ready(p:ptr<Cell>,limit:usize,base:usize) {
    exists used:usize = 0usize;
    owns(p);
    initialized(p.value,0..1);
    p.value<=42;
    limit<=10usize;
    base<=3usize;
    used<=7usize;
}
fn main()->u64 {
    return run(true);
}
fn initial(seed:bool)->usize
ensures result<=3usize;
{
    if seed { return 1usize; }
    return 3usize;
}
fn run(seed:bool)->u64 {
    let p=alloc<Cell>(1);
    p.value=42;
    let base=initial(seed);
    let mut count=initial(true);
    fold Ready(p,base+count,base) with (used=count);
    while count<7usize {
        invariant count<=7usize;
        unfold Ready(p,base+count,base);
        count=count+1usize;
        fold Ready(p,base+count,base) with (used=count);
    }
    unfold Ready(p,base+count,base);
    let outcome=p.value;
    free(p);
    finish Ready(p,base+count,base);
    return outcome;
}

// The predicate's affine count bound supplies the actual operand domain.
struct Buffer { slots:[u64;5], }
predicate Ready(p:ptr<Buffer>,n:usize) {
    owns(p);
    initialized(p.slots,0usize..2usize*n+1usize);
    2usize*n+1usize<=5usize;
}
fn main()->u64 {
    let p=alloc<Buffer>(1);
    p.slots[0]=42;
    p.slots[1]=7;
    p.slots[2]=8;
    p.slots[3]=9;
    p.slots[4]=10;
    fold Ready(p,2usize);
    return consume(p,2usize);
}
fn relay(p:Own<Buffer>,n:usize)->Own<Buffer>
requires Ready(p,n);
ensures Ready(result,n);
{
    return p;
}
fn consume(p:Own<Buffer>,n:usize)->u64
requires Ready(p,n);
{
    let q=relay(p,n);
    unfold Ready(q,n);
    let value=q.slots[0];
    free(q);
    finish Ready(q,n);
    return value;
}

fn main() -> u64 {
    let mut values = [10, 20, 30, 40];
    bump(&mut values[1..3], 1usize);
    let view = &values[1..3];
    return read(view, 1usize) + empty(&values[4..4]);
}

fn bump(view: &mut [u64], index: usize) {
    if index < len(view) {
        view[index] = 42;
    }
    return;
}

fn read(view: &[u64], index: usize) -> u64 {
    if index < len(view) {
        return view[index];
    }
    return 0;
}

fn empty(view: &[u64]) -> u64 {
    if len(view) == 0usize {
        return 0;
    }
    return view[0];
}

// The existential initialized endpoint has no runtime SSA carrier.
struct Buffer { slots:[u64;4], }
predicate Ready(p:ptr<Buffer>) {
    exists used:usize;
    owns(p);
    initialized(p.slots,0usize..used);
    1usize<=used;
    used<=3usize;
}
fn main()->u64 {
    let p=alloc<Buffer>(1);
    p.slots[0]=42;
    p.slots[1]=7;
    fold Ready(p) with (used=2usize);
    return consume(p);
}
fn relay(p:Own<Buffer>)->Own<Buffer>
requires Ready(p);
ensures Ready(result);
{
    let mut i=0usize;
    while i<2usize {
        invariant i<=2usize;
        unfold Ready(p) as (saved);
        fold Ready(p) with (used=saved);
        i=i+1usize;
    }
    return p;
}
fn consume(p:Own<Buffer>)->u64
requires Ready(p);
{
    let q=relay(p);
    unfold Ready(q);
    let value=q.slots[0];
    free(q);
    finish Ready(q);
    return value;
}

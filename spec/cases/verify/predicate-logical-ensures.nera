struct Cell { value:u64, }
predicate Ready(limit:usize,p:ptr<Cell>) {
    owns(p);
    initialized(p.value,0..1);
    limit == limit;
}
fn main()->u64 {
    let p=alloc<Cell>(1);
    p.value=42;
    fold Ready(7usize,p);
    let q=forward(7usize,p);
    return consume(q,7usize);
}
fn select(p:Own<Cell>,limit:usize,left:bool)->Own<Cell>
requires Ready(limit,p);
ensures Ready(limit,result);
{
    if left { return p; } else { return p; }
}
fn forward(limit:usize,p:Own<Cell>)->Own<Cell>
requires Ready(limit,p);
ensures Ready(limit,result);
{
    return select(p,limit,true);
}
fn consume(p:Own<Cell>,limit:usize)->u64
requires Ready(limit,p);
{
    unfold Ready(limit,p);
    let value=p.value;
    free(p);
    finish Ready(limit,p);
    return value;
}

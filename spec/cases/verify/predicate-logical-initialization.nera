// The contract carries an initialized prefix whose endpoint has no runtime SSA.
// Only its lower bound is available for an unconditional read in consume.
struct Buffer { slots:[u64;4], }
predicate Ready(p:ptr<Buffer>) {
    exists used:usize;
    owns(p);
    initialized(p.slots,0usize..used);
    1usize<=used;
    used<=3usize;
}
fn main()->u64 {
    let p=alloc<Buffer>(1);
    p.slots[0]=42;
    p.slots[1]=7;
    fold Ready(p) with (used=2usize);
    return consume(p);
}
fn relay(p:Own<Buffer>)->Own<Buffer>
requires Ready(p);
ensures Ready(result);
{
    unfold Ready(p) as (saved);
    fold Ready(p) with (used=saved);
    return p;
}
fn consume(p:Own<Buffer>)->u64
requires Ready(p);
{
    let q=relay(p);
    unfold Ready(q);
    let value=q.slots[0];
    free(q);
    finish Ready(q);
    return value;
}

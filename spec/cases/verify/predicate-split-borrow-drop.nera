// Parent authority is restored only after both stored child loans end.
struct Storage { item:&mut u64, }
predicate Pair(a:ptr<u64>,b:ptr<u64>) {
    owns(a);
    owns(b);
    initialized(a,0usize..1usize);
}
fn main()->u64 {
    let a=alloc<u64>(1);
    let b=alloc<u64>(1);
    *a=42;
    let total=*a;
    fold Pair(a,b);
    {
        let va=&mut *a;
        let vb=&mut *b;
        let left=Storage { item:va };
        { let right=Storage { item:vb }; }
    }
    unfold Pair(a,b);
    free(a);
    free(b);
    finish Pair(a,b);
    return total;
}

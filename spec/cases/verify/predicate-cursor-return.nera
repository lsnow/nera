// Return the old cursor through a checked call while advancing the sealed arena.
opaque struct Arena { cursor:usize, slots:[u64;8], }
predicate Ready(p:ptr<Arena>) {
    owns(p);
    initialized(p.cursor,0usize..1usize);
    initialized(p.slots,0usize..p.cursor);
    p.cursor <= 8usize;
}
fn main()->u64 {
    let a=make();
    let b=append_owner(a,42);
    return destroy(b);
}
fn make()->Own<Arena>
ensures Ready(result);
ensures result.cursor==0usize;
{
    let p=alloc<Arena>(1);
    p.cursor=0usize;
    fold Ready(p);
    return p;
}
fn append_owner(p:Own<Arena>,value:u64)->Own<Arena>
requires Ready(p);
requires p.cursor<8usize;
ensures Ready(result);
ensures result.cursor==old(p.cursor)+1usize;
{
    let index=append_index(&mut *p,value);
    assert index<8usize;
    return p;
}
fn append(p:&mut Arena,value:u64)->usize
requires Ready(p);
requires p.cursor<8usize;
ensures Ready(p);
ensures p.cursor==old(p.cursor)+1usize;
ensures result==old(p.cursor);
{
    unfold Ready(p);
    let n=p.cursor;
    if n<8usize {
        p.slots[n]=value;
        p.cursor=n+1usize;
        fold Ready(p);
        return n;
    }
    fold Ready(p);
    return n;
}
fn append_index(p:&mut Arena,value:u64)->usize
requires Ready(p);
requires p.cursor<8usize;
ensures Ready(p);
ensures p.cursor==old(p.cursor)+1usize;
ensures result==old(p.cursor);
{
    return append(p,value);
}
fn destroy(p:Own<Arena>)->u64
requires Ready(p);
{
    unfold Ready(p);
    let n=p.cursor;
    if n>=1usize {
        let total=p.slots[0];
        free(p);
        finish Ready(p);
        return total;
    }
    free(p);
    finish Ready(p);
    return 0;
}

// Package equalities can discharge scalar arguments after a same-instance refold.
struct Cell { value:u64, }
predicate Ready(p:ptr<Cell>,limit:usize) {
    exists used:usize = 0usize;
    owns(p);
    initialized(p.value,0..1);
    used==limit;
}
fn main()->u64 {
    let p=alloc<Cell>(1);
    p.value=42;
    fold Ready(p,7usize) with (used=7usize);
    return consume(p,7usize);
}
fn consume(p:Own<Cell>,limit:usize)->u64
requires Ready(p,limit);
{
    unfold Ready(p,limit) as (first);
    fold Ready(p,limit) with (used=first);
    unfold Ready(p,limit) as (saved);
    let outcome=p.value;
    free(p);
    finish Ready(p,saved);
    return outcome;
}

struct Cell { value:u64, }
predicate Ready(p:ptr<Cell>,choice:bool) {
    owns(p);
    initialized(p.value,0..1);
    p.value<=42;
}
fn main()->u64 { return choose(true,false,false,true); }
fn forward(p:&mut Cell,a:bool,b:bool)
requires Ready(p,a&&b);
ensures Ready(p,a&&b);
{     return;
}
fn choose(first:bool,second:bool,other:bool,which:bool)->u64 {
    let p=alloc<Cell>(1);
    p.value=42;
    let mut a=first;
    let b=second;
    if which {
        fold Ready(p,a&&b);
    } else {
        a=other;
        fold Ready(p,a&&b);
    }
    forward(&mut *p,a,b);
    unfold Ready(p,a&&b);
    let outcome=p.value;
    free(p);
    finish Ready(p,a&&b);
    return outcome;
}

// In-place postconditions restore a predicate on the original mutable parameter.
opaque struct Arena {
    cursor: usize,
    slots: [u64; 8],
}
predicate Ready(p: ptr<Arena>) {
    owns(p);
    initialized(p, 0usize..1usize);
    p.cursor <= 8usize;
}
fn main() -> u64 {
    let a = make();
    let view = begin(&mut *a);
    let b = fill(view);
    let previous = reset(b);
    let slice = take(b);
    let total = slice[0] + slice[1] + previous;
    free(a);
    return total;
}
fn make() -> Own<Arena>
{
    let p = alloc<Arena>(1);
    p.cursor = 0usize;
    p.slots = [0, 0, 0, 0, 0, 0, 0, 0];
    return p;
}
fn begin(p: &mut Arena) -> &mut Arena
ensures Ready(result);
{
    p.cursor = 0usize;
    fold Ready(p);
    return p;
}
fn fill(p: &mut Arena) -> &mut Arena
requires Ready(p);
ensures Ready(result);
{
    unfold Ready(p);
    let left = &mut p.slots[0usize..2usize];
    let right = &mut p.slots[2usize..4usize];
    left[0] = 12;
    right[0] = 30;
    let total = left[0] + right[0];
    p.slots[0] = total;
    p.cursor = 4usize;
    fold Ready(p);
    return p;
}
fn reset(p: &mut Arena) -> u64
requires Ready(p);
ensures Ready(p);
{
    unfold Ready(p);
    p.cursor = 0usize;
    fold Ready(p);
    return 0;
}
fn take(p: &mut Arena) -> &mut [u64; 8]
requires Ready(p);
{
    unfold Ready(p);
    p.cursor = 2usize;
    let view = &mut p.slots;
    finish Ready(p);
    return view;
}
